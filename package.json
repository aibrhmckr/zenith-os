{
  "name": "zenith",
  "version": "1.0.2",
  "description": "Zenith OS game library and console dashboard for Windows and Linux",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "source-map-js": "1.2.2",
    "http-cache-semantics": "4.3.0",
    "extract-zip": "npm:@electron-internal/extract-zip@1.0.5",
    "@electron-internal/extract-zip": "1.0.5",
    "global-agent": "4.1.3"
  },
  "scripts": {
    "test:wallpapers": "node --test tests/wallpapers.test.mjs && npm run build && electron tests/wallpapers.cjs",
    "setup:emulators": "node scripts/setup-emulators.mjs",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "test:dev-renderer": "electron-vite dev --entry tests/dev-renderer.cjs",
    "build": "electron-vite build",
    "prerelease": "npm run build",
    "release": "electron-builder --publish always",
    "test:app-updates": "node --test tests/application-updater.test.mjs tests/software-updates.test.mjs && npm run build && electron tests/app-updates.cjs",
    "test:local-games": "npm run build && electron tests/local-games.cjs && electron tests/local-games.cjs --psp-path",
    "test:launcher": "npm run build && electron tests/launcher.cjs",
    "test:bios": "npm run build && electron tests/bios.cjs",
    "test:scraper": "node --test tests/scraper.test.mjs",
    "test:media": "npm run build && electron tests/media.cjs",
    "test:guide": "node --test tests/guide.test.mjs",
    "test:guide-ui": "npm run build && electron tests/guide.cjs",
    "test:controller": "npm run build && electron tests/controller.cjs",
    "test:media-paths": "node --test tests/media-paths.test.mjs",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win nsis --x64",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux AppImage deb --x64",
    "test:console-services": "node --test tests/console-services.test.mjs",
    "test:console": "npm run build && electron tests/console-os.cjs",
    "test:platform": "node --test tests/platform.test.mjs",
    "test:import-hotkeys": "node --test tests/import-hotkeys.test.mjs",
    "test:hotkeys": "npm run build && electron tests/hotkeys.cjs",
    "check:distribution": "node scripts/check-distribution.mjs",
    "test:core-catalog": "node --test tests/core-catalog.test.mjs",
    "test:core-browser": "npm run build && electron tests/core-browser.cjs",
    "test:core-download": "npm run build && electron tests/core-download.cjs",
    "test:runtime-startup": "npm run build && electron tests/runtime-startup.cjs && electron tests/runtime-startup.cjs --critical",
    "test:rpcs3": "node --test tests/rpcs3.test.mjs tests/rpcs3-install.test.mjs tests/rpcs3-library.test.mjs && npm run build && electron tests/rpcs3-launcher.cjs",
    "test:media-settings": "npm run build && electron tests/media-settings.cjs",
    "test:file-browser": "node --test tests/file-browser.test.mjs && npm run build && electron tests/file-browser.cjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@rollup/rollup-win32-x64-msvc": "^4.63.5",
    "7zip-bin": "^5.2.0",
    "7zip-bin-full": "26.3.1",
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@rollup/wasm-node": "^4.63.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.6.1",
    "electron": "42.11.15",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "postcss": "^8.5.28",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.3",
    "vite": "^7.2.6"
  }
}
