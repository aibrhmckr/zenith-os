# ========================================================
# 1. BAĞIMLILIKLAR VE DERLEME ÇIKTILARI
# ========================================================
node_modules/
dist/
out/
build/
.eslintcache
.DS_Store
Thumbs.db
desktop.ini
띥/

# ========================================================
# 2. GİZLİ BİLGİLER VE API ANAHTARLARI
# ========================================================
.env
.env.local
.env.*.local
*.pem
*.key

# ========================================================
# 3. LOGLAR, GEÇİCİ VE SİSTEM ÇALIŞMA KAYITLARI
# ========================================================
*.log*
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
emulators/retroarch/retroarch.log

# ========================================================
# 4. OYUN DOSYALARI, ROM'LAR VE DİSK İMAJLARI (TELİF)
# ========================================================
# Bilinen oyun ve rom klasörleri:
games/
roms/
/games/*
!/games/.gitkeep
!/games/README.md
/roms/*
!/roms/.gitkeep

# Projenin herhangi bir yerinde bulunabilecek ROM ve disk formatları:
*.iso
*.bin
*.cue
*.chd
*.cso
*.nds
*.gba
*.gbc
*.sfc
*.smc
*.z64
*.n64
*.pbp
*.gdi
*.cdi
*.wbfs
*.rvz
*.cia
*.3ds
*.nsp
*.xci

# ========================================================
# 5. TELİFLİ BİOS'LAR, SAVE VE EMÜLATÖR ÇALIŞMA ARTIKLARI
# ========================================================
emulators/retroarch/cores/
emulators/retroarch/system/
emulators/retroarch/system/*
!emulators/retroarch/system/.gitkeep
emulators/retroarch/saves/
emulators/retroarch/states/
emulators/retroarch/screenshots/
emulators/retroarch/thumbnails/*
!emulators/retroarch/thumbnails/.gitkeep
emulators/retroarch/records/
emulators/retroarch/recordings/
emulators/retroarch/config/
emulators/retroarch/cheats/
emulators/retroarch/downloads/
emulators/retroarch/playlists/
emulators/retroarch/logs/
*.lpl
*.lrtl
*.opt
*.srm
*.state*

# RetroArch çalıştırılabilir ve çekirdek (.exe, .dll) ikili dosyaları:
emulators/retroarch/*.exe
emulators/retroarch/*.dll
emulators/retroarch/cores/*.dll

# ========================================================
# 6. MEDYA, VİDEO, MÜZİK VE KILAVUZ DOSYALARI (TELİF & BOYUT)
# ========================================================
# Olası yerel medya klasörleri (projenin neresinde açılırsa açılsın yok sayılır):
media/
media/**
videos/
videos/**
music/
music/**
manuals/
manuals/**
trailers/
trailers/**

# Projenin herhangi bir yerine atılabilecek tüm medya uzantıları:
*.mp4
*.mkv
*.avi
*.webm
*.mov
*.mp3
*.ogg
*.wav
*.flac
*.aac
*.pdf
*.cbr
*.cbz
